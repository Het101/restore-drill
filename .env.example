# Any S3-compatible storage. For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=hetops-backups
# A read-only key scoped to the bucket: the drill never writes.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional
# DRILL_CONFIG=/app/drills.yml
# PORT=3000

# Alerts (optional): a Slack/Discord/any JSON webhook, and/or email over SMTP
# ALERT_WEBHOOK_URL=
# ALERT_EMAIL_TO=you@example.com
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Restore Drill <no-reply@example.com>
